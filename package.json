{
  "name": "proxyduck",
  "version": "1.0.0",
  "description": "Fast per-application proxy routing for Windows.",
  "scripts": {
    "icon:build": "powershell -ExecutionPolicy Bypass -File .\\scripts\\generate-icon.ps1",
    "test": "node --test smartflow-ui/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check:ui": "node --check smartflow-ui/dist/app.js && node --check smartflow-ui/dist/api.mjs && node --check smartflow-ui/dist/lib.mjs && node --check smartflow-ui/dist/i18n.mjs",
    "verify": "powershell -ExecutionPolicy Bypass -File .\\scripts\\verify-release.ps1",
    "smoke:release": "powershell -ExecutionPolicy Bypass -File .\\scripts\\smoke-release.ps1",
    "package:release": "powershell -ExecutionPolicy Bypass -File .\\scripts\\package-release.ps1",
    "stability:smoke": "powershell -ExecutionPolicy Bypass -File .\\scripts\\stability-smoke.ps1",
    "check:versions": "powershell -ExecutionPolicy Bypass -File .\\scripts\\check-versions.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "png-to-ico": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
